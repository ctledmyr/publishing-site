---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const start = await getEntry('start', 'start');
const posts = await getCollection('posts', ({ data }) => !data.draft);

// Skip any slug that does not match a published post
const cards = (start?.data.texter ?? []).flatMap((item) => {
  const post = posts.find((p) => p.slug === item.slug.trim());
  return post ? [{ post, line: item.rad }] : [];
});

const Welcome = start ? (await start.render()).Content : null;
---
<BaseLayout title="Things Written" description="Texter av Things Written.">
  {Welcome && (
    <section class="welcome">
      <Welcome />
    </section>
  )}

  {cards.length > 0 && (
    <ul class="cards">
      {cards.map(({ post, line }) => (
        <li>
          <a href={`/posts/${post.slug}`} class="card">
            <span class="card-title">{post.data.title}</span>
            {line && <span class="card-line">{line}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}

  <p class="all-texts">
    <a href="/texter">Alla texter &rarr;</a>
  </p>
</BaseLayout>

<style>
  /* Warm page tone behind the letter, landing page only */
  :global(html body:has(.welcome)) {
    background-color: #f7f5f1;
  }

  .welcome {
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    padding: 48px;
    background-color: #ffffff;
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 28px rgba(0, 0, 0, 0.07);
  }

  @media (max-width: 600px) {
    .welcome {
      padding: 24px;
    }
  }

  .welcome :global(p) {
    margin: 0 0 1.8em 0;
  }

  .welcome :global(p:last-child) {
    margin-bottom: 0;
  }

  .cards {
    list-style: none;
    margin: 0 0 2rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--color-muted);
  }

  .card-title {
    font-size: 1.5rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .card-line {
    font-size: 1rem;
    color: var(--color-muted);
  }

  .all-texts {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .all-texts a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .all-texts a:hover {
    color: var(--color-text);
  }
</style>
